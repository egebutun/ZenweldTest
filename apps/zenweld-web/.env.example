# Ortam değişkenleri örneği.
#
# Bilgisayarda: bu dosyayı aynı klasöre .env.local adıyla kopyalayıp
# değerleri doldurun. .env.local GitHub'a gönderilmez (.gitignore).
# Sunucuda: ortam değişkeni olarak (demoda Vercel › Project Settings ›
# Environment Variables).
#
# Hiçbiri zorunlu değildir; boş bırakılırsa site çalışır, yalnızca e-posta
# gitmez ve site adresi otomatik bulunur. Açıklamalar: docs/SUNUCU.md
# (9. Barındırma ve ortam değişkenleri).
#
# Gerçek anahtarlar bu dosyaya yazılmaz.

# Sitenin adresi (ör. https://zenweld.com). Canonical adresler, site
# haritası, paylaşım önizlemesi ve arama motorlarına açıklık buna göre
# belirlenir. Boşsa demoda Vercel'in adresi, o da yoksa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# E-posta servisi (resend.com) anahtarı. Gizlidir; yalnızca sunucuda durur.
RESEND_API_KEY=

# Form e-postalarının varsayılan alıcısı. Boşsa info@zenweld.com.
# Veritabanı modunda tür başına alıcı panelden (Mağaza Ayarları › E-posta Alıcıları) değişir.
SUPPORT_EMAIL=

# Resend'de doğrulanmış gönderici, ör. Zenweld Web <web@zenweld.com>.
# Boşsa Resend'in deneme adresi kullanılır; canlıda doldurulmalı.
SUPPORT_FROM=

# Yalnızca panel ileride ayrı bir adrese (ör. admin.zenweld.com) taşınırsa:
# ana sitenin adresi. Bugün boş kalır.
NEXT_PUBLIC_MAIN_SITE_URL=

# Veritabanı (PostgreSQL) bağlantı adresi. Gizlidir; yalnızca sunucuda durur.
# Bilgisayarda (docker compose ile): postgres://zenweld:zenweld@localhost:5432/zenweld
# npm run db:* komutları kullanır; site yalnızca DATA_SOURCE=database ise
# kullanır (README › Veritabanı).
DATABASE_URL=

# Sitenin veri kaynağı (KARARLAR K-88). Boşsa site bugünkü gibi tarayıcıdaki
# veriyle çalışır. "database" yazılırsa ürünler, kategoriler, seçenekler,
# Zenweld depo stoğu, mağaza ayarları, bayiler, bayi ve satıcı stokları,
# yorumlar ve içerik (blog, haber, etkinlik, SSS, yasal metinler, Hakkımızda,
# satış temsilcileri, belgeler, Sayfa SEO) DATABASE_URL'deki veritabanından
# okunur; veritabanındaki değişiklik en geç bir dakikada sitede görünür.
# Derlemede de okunur: değiştirince site yeniden derlenir ve derleme
# sırasında veritabanına erişilebilmelidir.
DATA_SOURCE=

# Siteyi beklemeden yenileme anahtarı (Aşama 3.6). Gizlidir; yalnızca
# sunucuda durur. Tanımlıysa /api/yenile ucu açılır: veritabanında yapılan
# değişiklikten sonra `npm run site:yenile` ile site o anda yenilenir.
# Boşsa uç kapalıdır. Uzun ve tahmin edilemez bir değer olmalı.
REVALIDATE_SECRET=

# Zamanlanmış işlerin anahtarı (SAP stok okuma 15 dakikada bir, SAP'a
# sipariş aktarımı birkaç dakikada bir). Gizlidir; yalnızca sunucuda durur.
# Tanımlıysa /api/sap/stok ve /api/sap/siparis uçları açılır; zamanlayıcı,
# `npm run sap:stok` ve `npm run sap:siparis` bu anahtarla çağırır. Boşsa
# uçlar kapalıdır.
CRON_SECRET=

# Kartla ödemenin sağlayıcısı (KARARLAR K-108). Boş bırakın: "temsili" (para
# çekilmez, sipariş ödenmiş sayılır). Ödeme kuruluşu bağlanınca adı yazılır;
# kuruluşun anahtarları ayrı değişkenlerde, yalnızca sunucuda durur.
ODEME_SAGLAYICI=

# SAP bağlanana kadar depo stoğunun okunacağı deneme dosyası (CSV, başlık
# kod;ad;miktar). Göreli yol sitenin klasörüne (apps/zenweld-web) göredir.
# Bilgisayarda örnek: ../../packages/db/deneme/sap-stok.csv
SAP_STOK_DOSYASI=

# Panelde yüklenen görsel ve belgelerin yazılacağı klasör (dosya deposu;
# KARARLAR K-108). Göreli yol sitenin klasörüne göredir; canlıda sunucunun
# yedeğine eklenmeli. Boşsa veritabanı modunda panelde dosya yerine adres
# girilir. Bilgisayarda örnek (depo dışında): /tmp/zenweld-dosyalar
DOSYA_KLASORU=

# SAP bağlanana kadar SAP'a aktarılan siparişlerin yazılacağı deneme dosyası
# (her satıra bir sipariş, JSON; KARARLAR K-108). Göreli yol sitenin
# klasörüne göredir. Boşsa siparişler aktarım sırasında bekler.
# Bilgisayarda örnek (depo dışında): /tmp/zenweld-sap-siparisler.jsonl
SAP_SIPARIS_DOSYASI=

# Derleme klasörü. Boş bırakın (.next). Yalnızca veritabanı modunun
# testleri (npm run test:e2e:db) .next-db kullanır.
NEXT_DIST_DIR=

# Yalnızca `npm run site:yenile` ve `npm run sap:stok` komutları için: sitenin adresi.
# Boşsa NEXT_PUBLIC_SITE_URL, o da boşsa http://localhost:3000.
SITE_URL=

# Yalnızca veritabanı testleri (npm run test:db). Her çalıştırmada silinip
# baştan kurulur; DATABASE_URL ile aynı olamaz.
# Bilgisayarda: postgres://zenweld:zenweld@localhost:5432/zenweld_test
TEST_DATABASE_URL=
