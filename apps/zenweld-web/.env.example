# Ortam değişkenleri örneği.
#
# Bilgisayarda: bu dosyayı aynı klasöre .env.local adıyla kopyalayıp
# değerleri doldurun. .env.local GitHub'a gönderilmez (.gitignore).
# Vercel'de: Project Settings › Environment Variables.
#
# Hiçbiri zorunlu değildir; boş bırakılırsa site çalışır, yalnızca e-posta
# gitmez ve site adresi otomatik bulunur. Açıklamalar: docs/ENTEGRASYONLAR.md
# (9. Barındırma ve ortam değişkenleri).
#
# Gerçek anahtarlar bu dosyaya yazılmaz.

# Sitenin adresi (ör. https://zenweld.com). Canonical adresler, site
# haritası, paylaşım önizlemesi ve arama motorlarına açıklık buna göre
# belirlenir. Boşsa Vercel'in adresi, o da yoksa http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# E-posta servisi (resend.com) anahtarı. Gizlidir; yalnızca sunucuda durur.
RESEND_API_KEY=

# Form e-postalarının alıcısı. Boşsa info@zenweld.com.
SUPPORT_EMAIL=

# Resend'de doğrulanmış gönderici, ör. Zenweld Web <web@zenweld.com>.
# Boşsa Resend'in deneme adresi kullanılır; canlıda doldurulmalı.
SUPPORT_FROM=

# Yalnızca panel ileride ayrı bir adrese (ör. admin.zenweld.com) taşınırsa:
# ana sitenin adresi. Bugün boş kalır.
NEXT_PUBLIC_MAIN_SITE_URL=
